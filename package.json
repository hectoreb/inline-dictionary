{
  "name": "inline-dictionary",
  "version": "0.1.0",
  "description": "Cross-browser extension that shows word definitions inline in a popover. Sources: Wikcionario (ES) + Merriam-Webster (EN).",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/dev.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf build/"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.268",
    "@types/node": "^20.12.7",
    "esbuild": "^0.21.5",
    "fake-indexeddb": "^6.0.0",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  },
  "dependencies": {
    "idb-keyval": "^6.2.1"
  }
}
